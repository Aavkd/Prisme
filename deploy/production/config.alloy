// Alloy de production sur ovh-mantara (étape 4).
// - Hôte : node_exporter (CPU, RAM, swap, `/` seulement, réseau) et le fichier
//   /var/lib/prisme-metrics/host.prom écrit par prisme-host-metrics.timer.
// - Conteneurs : cAdvisor (via containerd) pour TOUS les conteneurs du VPS,
//   libellés par projet/service Compose ; les logs ne sont collectés que pour
//   les conteneurs de Prisme (prisme.observation=true), après masquage.
// - Sites : un check HTTPS par adresse servie par le Caddy mutualisé, toutes les
//   30 s, par le DNS public (Cloudflare pour les domaines proxifiés). Ajouter ici
//   chaque nouveau site, avec sa portée et ses règles dans observability.json.
logging {
  level = "warn"
}
prometheus.remote_write "metrics" {
  endpoint {
    url = "http://victoriametrics:8428/api/v1/write"
  }
  wal {
    max_keepalive_time = "2h"
  }
}

// ── Sites ───────────────────────────────────────────────────────────
// Réussite : 2xx, redirection, ou accès protégé (401/403). Échec : 404, 5xx,
// délai dépassé, TLS invalide ou site injoignable. Les redirections ne sont pas suivies.
