prometheus.scrape "sites" {
  targets         = prometheus.exporter.blackbox.sites.targets
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.metrics.receiver]
}

// ── Hôte ────────────────────────────────────────────────────────────
prometheus.exporter.unix "host" {
  rootfs_path    = "/host/root"
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "diskstats", "netdev", "stat", "time", "uname", "textfile"]
  textfile {
    directory = "/host/root/var/lib/prisme-metrics"
  }
}
prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host.receiver]
}
prometheus.relabel "host" {
  // Alloy's container hostname changes at every recreation: a fixed instance
  // keeps one series per metric (rules need exactly one).
  rule {
    target_label = "instance"
    replacement  = "ovh-mantara"
  }
  // Rules need exactly one series: keep the root filesystem only.
  rule {
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.+;(|[^/].*|/.+)"
    action        = "drop"
  }
  rule {
    target_label = "server"
    replacement  = "ovh-mantara"
  }
  rule {
    target_label = "project"
    replacement  = "infrastructure"
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
  rule {
    target_label = "service"
    replacement  = "host"
  }
  forward_to = [prometheus.remote_write.metrics.receiver]
}

// ── Alloy ───────────────────────────────────────────────────────────
prometheus.exporter.self "alloy" {}
prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.alloy.receiver]
}
prometheus.relabel "alloy" {
  // Alloy's container hostname changes at every recreation: a fixed instance
  // keeps one series per metric (rules need exactly one).
  rule {
    target_label = "instance"
    replacement  = "ovh-mantara"
  }
  rule {
    target_label = "server"
    replacement  = "ovh-mantara"
  }
  rule {
    target_label = "project"
    replacement  = "infrastructure"
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
  rule {
    target_label = "service"
    replacement  = "alloy"
  }
  forward_to = [prometheus.remote_write.metrics.receiver]
}

// ── Conteneurs (cAdvisor) ───────────────────────────────────────────
prometheus.exporter.cadvisor "docker" {
  docker_only                  = true
  containerd_host              = "/rootfs/run/containerd/containerd.sock"
  containerd_namespace         = "moby"
  store_container_labels       = false
  allowlisted_container_labels = ["prisme.observation", "prisme.project", "prisme.environment", "com.docker.compose.service"]
  enabled_metrics              = ["cpu", "memory", "network", "oom_event"]
}
discovery.docker "all" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "30s"
}
// Labels: Prisme labels when present, otherwise the Compose project and service.
discovery.relabel "containers" {
  targets = discovery.docker.all.targets
  rule {
    target_label = "server"
    replacement  = "ovh-mantara"
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_project"]
    regex         = "(.+)"
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_service"]
    regex         = "(.+)"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_environment"]
    regex         = "(.+)"
    target_label  = "environment"
  }
}
// cAdvisor reads containers through containerd (VPS image store), without
// Compose labels. Each discovered container scrapes the exporter and keeps only
// its own samples, joined by immutable container ID. Targets with identical
// labels (one per network or port) collapse into one.
discovery.relabel "metric_targets" {
  targets = discovery.relabel.containers.output
  rule {
    target_label = "__address__"
    replacement  = "alloy:12345"
  }
  rule {
    target_label = "__metrics_path__"
    replacement  = "/api/v0/component/prometheus.exporter.cadvisor.docker/metrics"
  }
  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "container_name"
  }
}
prometheus.scrape "docker" {
  targets         = discovery.relabel.metric_targets.output
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.docker.receiver]
}
prometheus.relabel "docker" {
  rule {
    source_labels = ["id"]
    regex         = "(?:/docker/|/system.slice/docker-)([a-f0-9]{64})(?:\\.scope)?"
    target_label  = "__tmp_sample_id"
  }
  rule {
    source_labels = ["__tmp_sample_id"]
    target_label  = "container_id"
    action        = "keepequal"
  }
  rule {
    source_labels = ["container_name"]
    target_label  = "name"
  }
  rule {
    regex  = "container_label_.*|id|image|container_id|container_name|exported_.*|__tmp_.*"
    action = "labeldrop"
  }
  forward_to = [prometheus.remote_write.metrics.receiver]
}

// ── Logs (Prisme seulement) ─────────────────────────────────────────
discovery.docker "selected" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name   = "label"
    values = ["prisme.observation=true", "com.docker.compose.project=prisme"]
  }
}
discovery.relabel "logs" {
  targets = discovery.docker.selected.targets
  rule {
    target_label = "server"
    replacement  = "ovh-mantara"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_project"]
    target_label  = "project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_environment"]
    target_label  = "environment"
  }
  rule {
    source_labels = ["__meta_docker_container_label_prisme_service"]
    target_label  = "service"
  }
}
loki.source.docker "selected" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.logs.output
  refresh_interval = "5s"
  forward_to       = [loki.process.sanitized.receiver]
}
loki.process "sanitized" {
  stage.json {
    expressions = {level = "level"}
  }
  stage.template {
    source = "level"
    template = "{{ if eq .Value \"error\" }}error{{ else if eq .Value \"warning\" }}warning{{ else if eq .Value \"debug\" }}debug{{ else }}info{{ end }}"
  }
  stage.replace {
    expression = "(?i)(?:password|passwd|secret|token|api[_-]?key|authorization|cookie)\\\"?\\s*[:=]\\s*(\\\"[^\\\"]*\\\"|'[^']*'|[^\\s,;]+)"
    replace = "[REDACTED]"
  }
  stage.replace {
    expression = "(?i)Bearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace = "[REDACTED]"
  }
  stage.drop {
    expression = ".*PRIVATE KEY.*"
  }
  stage.replace {
    expression = "https?://([^\\s/@:]+:[^\\s/@]+)@"
    replace = "[REDACTED]"
  }
  stage.labels {
    values = {level = ""}
  }
  stage.label_keep {
    values = ["server", "project", "environment", "service", "level"]
  }
  forward_to = [loki.write.logs.receiver]
}
loki.write "logs" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
