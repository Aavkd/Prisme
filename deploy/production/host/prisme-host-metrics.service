[Unit]
Description=Prisme host gauges for Alloy (Docker container states, read-only)
After=docker.service

[Service]
Type=oneshot
User=prisme-collector
Group=prisme-observation
SupplementaryGroups=docker
# /var/lib/prisme-metrics: read by Alloy through its read-only view of the host.
StateDirectory=prisme-metrics
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/bin/python3 -I /usr/local/lib/prisme/host_metrics.py /var/lib/prisme-metrics
TimeoutStartSec=25
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
