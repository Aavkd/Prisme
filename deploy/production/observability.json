  "rules": [
    {"id": "VPS-HOST-COLLECTOR", "scope_id": "vps-host", "title": "Collecte hôte arrêtée (état des conteneurs non rafraîchi)", "metric": "prisme_host_metrics_age_seconds", "operator": "above", "open_threshold": 180, "resolve_threshold": 90, "for_seconds": 60, "recovery_seconds": 60, "min_samples": 3, "freshness_seconds": 60, "severity": "warning", "enabled": true, "inhibited_by": []},
    {"id": "VPS-RAM-LOW", "scope_id": "vps-host", "title": "RAM disponible faible sur le VPS (moins de 1 Gio)", "metric": "node_memory_MemAvailable_bytes", "operator": "below", "open_threshold": 1073741824, "resolve_threshold": 1610612736.0, "for_seconds": 300, "recovery_seconds": 300, "min_samples": 4, "freshness_seconds": 60, "severity": "warning", "enabled": true, "inhibited_by": []},
    {"id": "VPS-DISK-ROOT", "scope_id": "vps-host", "title": "Disque du VPS rempli à plus de 85 %", "metric": "node_filesystem_avail_bytes", "operator": "below", "open_threshold": 11531775590, "resolve_threshold": 13838130708, "for_seconds": 600, "recovery_seconds": 600, "min_samples": 4, "freshness_seconds": 60, "severity": "warning", "enabled": true, "inhibited_by": []},
    {"id": "VPS-SWAP-HIGH", "scope_id": "vps-host", "title": "Swap du VPS utilisé à plus de 75 %", "metric": "node_memory_SwapFree_bytes", "operator": "below", "open_threshold": 536869888, "resolve_threshold": 805304832, "for_seconds": 600, "recovery_seconds": 600, "min_samples": 4, "freshness_seconds": 60, "severity": "warning", "enabled": true, "inhibited_by": []},
    {"id": "VPS-CONTAINERS", "scope_id": "vps-host", "title": "Conteneur arrêté, en redémarrage ou en mauvaise santé sur le VPS", "metric": "prisme_containers_problem", "operator": "above", "open_threshold": 0, "resolve_threshold": 0, "for_seconds": 60, "recovery_seconds": 120, "min_samples": 3, "freshness_seconds": 90, "severity": "warning", "enabled": true, "inhibited_by": []},
    {"id": "PRISME-DRILL", "scope_id": "vps-host", "title": "Exercice Prisme (signal synthétique, aucune panne réelle)", "metric": "prisme_drill", "operator": "above", "open_threshold": 0, "resolve_threshold": 0, "for_seconds": 0, "recovery_seconds": 0, "min_samples": 2, "freshness_seconds": 90, "severity": "information", "enabled": true, "inhibited_by": []},
