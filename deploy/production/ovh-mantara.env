# Réglages NON secrets de la production sur ovh-mantara (relevés le 19/10/2026).
# Origine WebAuthn : RP ID prisme.mantara.fr, définitif avant toute passkey durable.
PRISME_AUTH_ORIGIN=https://prisme.mantara.fr
# Groupe du socket Docker (`getent group docker`) et du socket containerd
# (/run/containerd/containerd.sock, root:root 0660) : à relire après une réinstallation.
PRISME_DOCKER_SOCKET_GID=986
PRISME_CONTAINERD_SOCKET_GID=0
# Sous-réseau du réseau Docker `edge` (Caddy mutualisé) : seul autorisé à transmettre
# l'adresse du client (X-Forwarded-For) pour la limitation de débit et l'audit.
PRISME_TRUSTED_PROXY_CIDR=172.22.0.0/16
# Groupe hôte prisme-observation (créé par install-host.sh) : l'agent lit l'inventaire.
PRISME_OBSERVATION_GID=10002
