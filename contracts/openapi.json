  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque development session"
      },
      "agentCertificate": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secret",
          "device_name"
        ],
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "device_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "expires_at",
          "auth_mode"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "auth_mode": {
            "type": "string",
            "enum": [
              "development"
            ]
          }
        }
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "device_name",
          "expires_at",
          "auth_mode"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "device_name": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "auth_mode": {
            "type": "string",
            "enum": [
              "development"
            ]
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "Invitation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "expires_at",
          "capabilities"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "self:heartbeat"
              ]
            }
          }
        }
      },
      "EnrollRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "name",
          "csr_pem",
          "protocol_version"
        ],
        "properties": {
          "token": {
